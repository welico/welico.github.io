---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/strings';
import type { LocaleCode } from '../../i18n/locales';

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props;
---

<BaseLayout lang={lang} path="company/about" title={`${t(lang, 'company.about.title')} — Welico`}>
  <section>
    <div class="wrap" style="max-width:720px;">
      <span class="eyebrow">{t(lang, 'nav.company')}</span>
      <h1 style="font-size:var(--text-2xl);">{t(lang, 'company.about.title')}</h1>
      <p>{t(lang, 'company.about.body')}</p>
    </div>
  </section>
</BaseLayout>
