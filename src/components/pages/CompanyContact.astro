---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/strings';
import { href, type LocaleCode } from '../../i18n/locales';

interface Props {
  lang: LocaleCode;
}
const { lang } = Astro.props;
---

<BaseLayout lang={lang} path="company/contact" title={`${t(lang, 'company.contact.title')} — Welico`}>
  <section>
    <div class="wrap" style="max-width:720px;">
      <span class="eyebrow">{t(lang, 'nav.company')}</span>
      <h1 style="font-size:var(--text-2xl);">{t(lang, 'company.contact.title')}</h1>
      <p>
        {t(lang, 'company.contact.body')}
        {' '}
        <a href={href(lang, 'business')} style="color:var(--color-accent);">{t(lang, 'nav.business')}</a>
      </p>
      <a class="btn btn-primary" href="mailto:contact@welico.com">contact@welico.com</a>
    </div>
  </section>
</BaseLayout>
